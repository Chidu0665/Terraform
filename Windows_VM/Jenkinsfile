pipeline {
  agent any

  environment {
    ARM_CLIENT_ID       = credentials('ARM_CLIENT_ID')
    ARM_CLIENT_SECRET   = credentials('ARM_CLIENT_SECRET')
    ARM_TENANT_ID       = credentials('ARM_TENANT_ID')
    ARM_SUBSCRIPTION_ID = credentials('ARM_SUBSCRIPTION_ID')
  }

  stages {

    stage('Read Decomposition File') {
      steps {
        script {
          def path = 'Windows_VM/decomposition.json'

          if (!fileExists(path)) {
            error "Decomposition file not found at ${path}"
          }

          // GLOBAL config object
          config = readJSON file: path

          echo "Environment      : ${config.environment}"
          echo "Terraform Action : ${config.terraform_action}"
          echo "Approval Needed  : ${config.require_approval}"
        }
      }
    }

    stage('Terraform Init & Plan') {
      steps {
        dir('Windows_VM') {
          sh '''
            terraform init
            terraform plan -out=tfplan
          '''
        }
      }
    }

    stage('Create GitHub PR for Approval') {
      when {
        expression { config.require_approval == true }
      }
      steps {
        withCredentials([string(credentialsId: 'github-token-secret', variable: 'GITHUB_TOKEN')]) {
          script {
            def title = "Terraform ${config.terraform_action} for ${config.environment}"
            def body  = "Terraform plan requires approval before ${config.terraform_action}."

            sh """
              gh auth status || echo "\$GITHUB_TOKEN" | gh auth login --with-token

              if [ -z "\$CHANGE_ID" ]; then
                echo "No PR detected. Creating PR..."
                gh pr create \
                  --repo Chidu0665/Terraform \
                  --title "${title}" \
                  --body "${body}"
              else
                echo "PR already exists: #\$CHANGE_ID"
              fi
            """
          }
        }
      }
    }

    stage('Wait for PR Approval') {
      when {
        expression { config.require_approval == true && env.CHANGE_ID != null }
      }
      steps {
        script {
          timeout(time: 24, unit: 'HOURS') {
            waitUntil {
              def status = sh(
                script: """
                  gh pr view \$CHANGE_ID \
                    --repo Chidu0665/Terraform \
                    --json reviewDecision \
                    -q .reviewDecision
                """,
                returnStdout: true
              ).trim()

              echo "PR #${env.CHANGE_ID} review status: ${status}"
              return status == "APPROVED"
            }
          }
        }
      }
    }

    stage('Terraform Apply / Destroy') {
      steps {
        dir('Windows_VM') {
          script {
            if (config.terraform_action == "apply") {
              sh 'terraform apply -auto-approve tfplan'
            } else if (config.terraform_action == "destroy") {
              sh 'terraform destroy -auto-approve'
            } else {
              error "Invalid terraform_action: ${config.terraform_action}"
            }
          }
        }
      }
    }
  }
}
